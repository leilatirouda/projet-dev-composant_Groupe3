                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/structures/1.0.0/structures"
          }
        },
        {
          "name": "T6 - Jeton invalide",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
