              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"Code 900908 dans la réponse\", () => pm.expect(pm.response.text()).to.include(\"900908\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenNoSub}}"
              }
            ],
            "url": "{{gateway}}/structures/1.0.0/structures"
          }
        }
      ]
    },
    {
      "name": "3 - Quota (T8) - lancer seul",
      "item": [
        {
          "name": "T8 - Dépassement du plan 10/min",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = (pm.collectionVariables.get(\"t8_count\") || 0) + 1;",
                  "pm.collectionVariables.set(\"t8_count\", n);",
                  "if (pm.response.code === 200 && n < 25) {",
                  "  postman.setNextRequest(\"T8 - Dépassement du plan 10/min\");",
                  "} else {",
                  "  pm.collectionVariables.set(\"t8_count\", 0);",
                  "  console.log(\"Appels avant rejet : \" + n);",
                  "  pm.test(\"HTTP 429 - quota dépassé\", () => pm.response.to.have.status(429));",
                  "  pm.test(\"Code 900804 dans la réponse\", () => pm.expect(pm.response.text()).to.include(\"900804\"));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{gateway}}/structures/1.0.0/structures?size=1"
          }
        }
      ]
    },
    {
      "name": "4 - Cycle de vie (après chaque commande wso2ctl)",
      "item": [
        {
          "name": "T9 - API bloquée  [après: wso2ctl block]",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 503 - API BLOCKED\", () => pm.response.to.have.status(503));",
                  "pm.test(\"Code 700700 dans la réponse\", () => pm.expect(pm.response.text()).to.include(\"700700\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{gateway}}/structures/1.0.0/structures"
          }
        },
        {
          "name": "T10 - Arrêt technique  [après: docker compose stop api]",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Erreur 5xx de la passerelle\", () => pm.expect(pm.response.code).to.be.within(500, 599));",
                  "pm.test(\"Code 101503 dans la réponse\", () => pm.expect(pm.response.text()).to.include(\"101503\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{gateway}}/structures/1.0.0/structures"
          }
        },
        {
          "name": "T7b - Souscription bloquée  [après: wso2ctl block-sub]",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Code 900907 dans la réponse\", () => pm.expect(pm.response.text()).to.include(\"900907\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{gateway}}/structures/1.0.0/structures"
          }
        },
        {
          "name": "T11a - v2 avec nouveaux champs  [après: wso2ctl new-version]",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test(\"Champs v2 présents\", () => pm.expect(s).to.include.keys(\"district\",\"capacite_lits\",\"services\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{gateway}}/structures/2.0.0/structures/1"
          }
        },
        {
          "name": "T11b - v2 filtre district",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Filtre district\", () => pm.response.json().items.forEach(s => pm.expect(s.district).to.eql(\"District de Bogodogo\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{gateway}}/structures/2.0.0/structures?district=District de Bogodogo"
          }
        },
        {
          "name": "T11c - v1 dépréciée répond toujours",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
